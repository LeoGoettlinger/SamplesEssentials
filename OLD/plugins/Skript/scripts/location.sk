command /nether:
    permission: custom.normal
    permission message: &cDu hast keine Berechtigung für diesen Befehl!
    trigger:
        execute player command "warp Nether"
        send "&2&lɴɪxᴏʀɪᴀ &8▸ &eWillkommen im Nether!" to player
