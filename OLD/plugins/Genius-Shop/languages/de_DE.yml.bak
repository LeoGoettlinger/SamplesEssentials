config-version: 4

messages:
  prefix: '&6&lᴘɪxᴇʟʀᴇᴀʟᴍ &8▸ '
  no-permission: '%prefix%&cDu hast keine Berechtigung, das zu tun.'
  player-only: '&cNur Spieler können diesen Befehl verwenden.'
  shop-not-found: '&cShop ''&e%shop%&c'' wurde nicht gefunden.'
  shop-no-permission: '%prefix%&cDu hast keine Berechtigung, den &e%shop%&c Shop zu
    öffnen.'
  shop-not-available: |-
    %prefix%&cDer &e%shop%&c Shop ist derzeit nicht verfügbar!
    %prefix%&7Verfügbar: &e%available-times%
  shop-always-available: '&aImmer'
  economy-not-ready: '&cDas Wirtschaftssystem ist nicht bereit.'
  not-enough-money: '&cDu kannst dir &7%amount%x &4%item%&c für &4%price% nicht leisten.'
  buy-success: '&eDu hast &7%amount%x &6%item%&e für &6%price% gekauft.'
  payment-error: '&cBei der Zahlung ist ein Fehler aufgetreten.'
  
  # Selling
  cannot-sell: '%prefix%&cDu kannst diesen Gegenstand nicht verkaufen.'
  no-items-to-sell: '%prefix%&cDu hast keine &e%item%&c zum Verkaufen.'
  sell-success: '%prefix%&aDu hast &7%amount%x &6%item%&a für &6%price% verkauft.'
  sell-all-success: '%prefix%&aDu hast insgesamt &7%amount%x &6%item%&a für &6%price%
    verkauft.'
  
  # Buying guard
  cannot-buy: '%prefix%&cDu kannst diesen Gegenstand nicht kaufen.'
  
  # Reload
  reload-no-permission: '%prefix%&cDu hast keine Berechtigung, das Plugin neu zu laden.'
  reload-success: '%prefix%&aGenius-Shop wurde neu geladen.'
  reload-failed: '%prefix%&cNeu laden fehlgeschlagen, überprüfe die Konsole.'
  update-available: '%prefix%&aEin neues Update ist verfügbar! &7(&c%current% &7->
    &a%new%&7)'
  
  # Time and Date
  time-separator: ', '
  time-range-separator: '-'
  date-range-separator: ' bis '
  day-range-separator: ' bis '
  # Natural language connectors
  and: ' und '
  during: ' während '
  between: ' zwischen '
  'true': ' am '
  in: ' im '
  in-the-month-of: ' im Monat '
  # Use \n for a new line
  line-break: |2+

  day-suffix-st: .
  day-suffix-nd: .
  day-suffix-rd: .
  day-suffix-th: .
  
  # Time and Date Translations
  days:
    monday: Montag
    tuesday: Dienstag
    wednesday: Mittwoch
    thursday: Donnerstag
    friday: Freitag
    saturday: Samstag
    sunday: Sonntag
    mon: Mo
    tue: Di
    wed: Mi
    thu: Do
    fri: Fr
    sat: Sa
    sun: So
  months:
    january: Januar
    february: Februar
    march: März
    april: April
    may: Mai
    june: Juni
    july: Juli
    august: August
    september: September
    october: Oktober
    november: November
    december: Dezember
    jan: Jan
    feb: Feb
    mar: Mär
    apr: Apr
    may_short: Mai
    jun: Jun
    jul: Jul
    aug: Aug
    sep: Sep
    oct: Okt
    nov: Nov
    dec: Dez

